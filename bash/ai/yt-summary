#!/usr/bin/env bash
#
# yt-summary — summarise a YouTube video: yt-transcript URL | summarise [opts]
#
# Any options after the URL are passed to summarise (--words, --prompt,
# --provider, --model).
#
set -euo pipefail

# --- resolve real path (run via symlink) and load shared helpers ------------
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REAL_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$REAL_DIR/../.." && pwd)"
# shellcheck source=../lib/common.sh
source "$REAL_DIR/../lib/common.sh"

if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
  printf 'Usage: %s <youtube-url> [summarise options]\n' "$(basename "$0")"
  printf '  e.g. %s URL --words 200 --prompt "focus on the advice"\n' "$(basename "$0")"
  exit 1
fi

url="$1"; shift
"$REPO_DIR/python/ai/yt-transcript" "$url" | "$REPO_DIR/python/ai/summarise" "$@"
