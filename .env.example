# Copy to .env (gitignored) and fill in. Tools read it wherever they're run from;
# variables already set in your shell take priority.

# summarise: uses Anthropic if this is set, otherwise OpenAI
ANTHROPIC_API_KEY=
# transcribe (Whisper), and summarise when no Anthropic key is set
OPENAI_API_KEY=
# speak (coming)
ELEVENLABS_API_KEY=

# Optional: force a provider for summarise (anthropic | openai)
# SUMMARISE_PROVIDER=
